# ─── Lemon Squeezy — Production (client-side reference only) ─
# Checkout is server-side; these are for display/validation only
VITE_LEMON_SQ_STORE_ID="pikappoint"
VITE_LEMON_SQ_PRODUCT_ID="1053733"          # Prod product ID
VITE_LEMON_SQ_VARIANT_ID="1652523"          # Prod variant ID

# ─── Lemon Squeezy — Test (client-side reference only) ───────
VITE_LEMON_SQ_TEST_PRODUCT_ID="1037216"     # Test product ID
VITE_LEMON_SQ_TEST_VARIANT_ID="1626754"     # Test variant ID

# ─── Lemon Squeezy — Supabase Edge Function Secrets ─────────
# Set via: supabase secrets set KEY=value
# NEVER use prod values in test/local environment
#
# Production (ENVIRONMENT=production):
#   LEMON_SQUEEZY_API_KEY=<prod api key>
#   LEMON_SQ_STORE_ID=pikappoint
#   LEMON_SQ_VARIANT_ID=1652523              # PROD variant — DO NOT use in tests
#
# Test (ENVIRONMENT=staging|test|development):
#   LEMON_SQ_TEST_API_KEY=<test api key>     # MUST differ from prod key
#   LEMON_SQ_TEST_VARIANT_ID=1626754         # Test variant — MUST differ from prod

# ─── hCaptcha ────────────────────────────────────────────────
VITE_HCAPTCHA_SITE_KEY=""
